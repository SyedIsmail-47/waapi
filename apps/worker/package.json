    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.4.2",
    "pino": "9.6.0",
    "postgres": "3.4.5",
    "prom-client": "15.1.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "pino-pretty": "13.0.0",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
