{
  "name": "waapi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:worker": "pnpm --filter @waapi/worker dev",
    "dev:api": "pnpm --filter @waapi/api dev",
    "dev:dashboard": "pnpm --filter @waapi/dashboard dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @waapi/worker db:generate",
    "db:migrate": "pnpm --filter @waapi/worker db:migrate",
    "seed": "tsx scripts/seed.ts",
    "cli": "tsx scripts/cli.ts",
    "ram-probe": "tsx scripts/ram-probe.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
