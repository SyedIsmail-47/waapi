{
  "name": "waapi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:worker": "pnpm --filter @waapi/worker dev",
    "dev:api": "pnpm --filter @waapi/api dev",
    "dev:webhooks": "pnpm --filter @waapi/api dev:webhooks",
    "dev:dashboard": "pnpm --filter @waapi/dashboard dev",
    "build:site": "pnpm --filter @waapi/shared build && pnpm --filter @waapi/site build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @waapi/shared build && pnpm --filter @waapi/db build && pnpm -r run typecheck",
    "test": "vitest run",
    "pretest": "pnpm --filter @waapi/shared build && pnpm --filter @waapi/db build",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @waapi/db db:generate",
    "db:migrate": "pnpm --filter @waapi/db db:migrate",
    "seed": "tsx scripts/seed.ts",
    "cli": "tsx scripts/cli.ts",
    "admin": "tsx scripts/admin-cli.ts",
    "preflight": "tsx scripts/preflight.ts",
    "ram-probe": "tsx scripts/ram-probe.ts",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:up:prod": "docker compose -f docker-compose.yml --profile prod up -d --build",
    "check:compose-prod": "powershell -NoProfile -File scripts/check-compose-prod.ps1",
    "smoke:prod": "tsx scripts/smoke-prod.ts"
  },
  "dependencies": {
    "@waapi/shared": "workspace:*",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "bullmq": "5.58.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "ioredis": "5.4.2",
    "postgres": "3.4.5",
    "prettier": "3.4.2",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
