{
  "name": "@waapi/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "drizzle"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@waapi/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
