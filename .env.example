# Product display name — keep in sync with packages/shared brand helper
BRAND_NAME=waapi

NODE_ENV=development
LOG_LEVEL=info

# Docker compose credentials (no defaults in docker-compose.yml)
POSTGRES_USER=waapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waapi
REDIS_PASSWORD=change-me

DATABASE_URL=postgresql://waapi:change-me@localhost:5432/waapi
REDIS_URL=redis://:change-me@localhost:6379

# API
API_PORT=3000
INTERNAL_PORT=3001
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=waapi
JWT_AUDIENCE=waapi-api
REFRESH_TTL=30d
ADMIN_API_SECRET=

# Email: console (non-production only) | resend | smtp
EMAIL_DRIVER=console
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=noreply@example.com
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

# Exactly 32 bytes, base64-encoded
WEBHOOK_SECRET_KEY=
WEBHOOK_MAX_ATTEMPTS=15
WEBHOOK_DEAD_AFTER_CONSECUTIVE=15
WEBHOOK_PAYLOAD_KEY_VERSION=v1
# WEBHOOK_PAYLOAD_KEY_RING={"v0":"<base64-or-hex-32-bytes>"}
WEBHOOK_PAYLOAD_PURGE_SUCCESS_HOURS=72
WEBHOOK_PAYLOAD_PURGE_FAILED_DAYS=7

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_ACCOUNT_MAX=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_RESET_PASSWORD=10
RATE_LIMIT_VERIFY_EMAIL=20
RATE_LIMIT_RESEND_VERIFICATION=5
SEND_RATE_LIMIT_MAX=60

# Required in production (no code default). Set intentionally for capacity.
GLOBAL_MAX_SESSIONS=100
DEFAULT_ACCOUNT_MAX_SESSIONS=1

# Comma-separated browser origins; empty = CORS disabled (API clients / gateway)
# CORS_ORIGINS=http://127.0.0.1:5173

# Numeric hop count for Fastify trustProxy (not boolean true)
TRUST_PROXY_HOPS=1
# Only true behind Cloudflare + deploy/nginx.conf real_ip (firewall CF-only)
TRUST_CLOUDFLARE=false
# Dev only: return verificationToken in register JSON (forbidden in production)
DEV_RETURN_TOKENS=false
ENABLE_DOCS=false
ALLOW_DOCS_IN_PROD=false
ALLOW_HTTP_WEBHOOKS=false

# Exactly 32 bytes: base64-encoded OR 64-char hex
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_STATE_ENCRYPTION_KEY=
AUTH_STATE_KEY_VERSION=1
# Optional JSON map of older versions for decrypt: {"1":"<base64|hex>"}
# AUTH_STATE_KEY_RING=

MAX_SESSIONS_PER_NODE=10
WORKER_METRICS_PORT=9091
BOOT_CONNECT_STAGGER_MS=500
SESSION_LEASE_TTL_MS=30000
# Per-session outbound send spacing (worker)
SEND_MIN_INTERVAL_MS=800
# Stable across restarts (defaults to OS hostname if unset — not a random UUID)
# WORKER_ID=worker-1

# Optional: seed uses this account id if set; otherwise a fixed UUID is used
SEED_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
