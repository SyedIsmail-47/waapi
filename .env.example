# Product display name — keep in sync with packages/shared brand helper
BRAND_NAME=waapi

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://waapi:waapi@localhost:5432/waapi
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
INTERNAL_PORT=3001
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=waapi
JWT_AUDIENCE=waapi-api
REFRESH_TTL=30d
ADMIN_API_SECRET=
EMAIL_DRIVER=console
# Exactly 32 bytes, base64-encoded
WEBHOOK_SECRET_KEY=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_RESET_PASSWORD=10
RATE_LIMIT_VERIFY_EMAIL=20
RATE_LIMIT_RESEND_VERIFICATION=5
SEND_RATE_LIMIT_MAX=60
GLOBAL_MAX_SESSIONS=10000
# Numeric hop count for Fastify trustProxy (not boolean true)
TRUST_PROXY_HOPS=1
# Only true behind Cloudflare + deploy/nginx.conf real_ip (firewall CF-only)
TRUST_CLOUDFLARE=false
# Dev only: return verificationToken in register JSON (forbidden in production)
DEV_RETURN_TOKENS=false
ENABLE_DOCS=false
ALLOW_DOCS_IN_PROD=false
ALLOW_HTTP_WEBHOOKS=false

# Exactly 32 bytes: base64-encoded OR 64-char hex
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_STATE_ENCRYPTION_KEY=
AUTH_STATE_KEY_VERSION=1
# Optional JSON map of older versions for decrypt: {"1":"<base64|hex>"}
# AUTH_STATE_KEY_RING=

MAX_SESSIONS_PER_NODE=10
WORKER_METRICS_PORT=9091
BOOT_CONNECT_STAGGER_MS=500
SESSION_LEASE_TTL_MS=30000
# Per-session outbound send spacing (worker)
SEND_MIN_INTERVAL_MS=800
# Stable across restarts (defaults to OS hostname if unset — not a random UUID)
# WORKER_ID=worker-1

# Optional: seed uses this account id if set; otherwise a fixed UUID is used
SEED_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
